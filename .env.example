# Public origin used for canonical URLs, sitemap entries, and social metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Full Cal.com event URL, for example: https://cal.com/your-team/qa-consultation
# Leave empty to use the built-in booking planner (calendar + form + email).
NEXT_PUBLIC_CALCOM_URL=

# Centralized business placeholders.
NEXT_PUBLIC_COMPANY_EMAIL=hello@example.com
NEXT_PUBLIC_LINKEDIN_URL=#
NEXT_PUBLIC_GITHUB_URL=#
# Public Upwork profile. When set, the "100% job success" badge links to it so
# the claim is verifiable; left empty the badge renders as plain text.
NEXT_PUBLIC_UPWORK_URL=

# Leave disabled until a real analytics adapter is connected and documented.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# --- Booking -----------------------------------------------------------------

# Timezone the published time slots are authored in. Visitors see them
# converted into their own zone.
NEXT_PUBLIC_BOOKING_TIMEZONE=Europe/Rome

# Your standing video room, sent to the client and used as the invite location.
# Must be https. Google Meet, Zoom, Teams and Whereby are labelled automatically.
# e.g. https://meet.google.com/abc-defg-hij  or  https://us05web.zoom.us/j/1234567890
MEET_ROOM_URL=

# Where the organiser copy (with the client's attachment and the calendar
# invite) is delivered.
BOOKING_ADMIN_EMAIL=

# --- Sending: pick ONE of the two routes below --------------------------------

# Route A — SMTP. Works with an ordinary mailbox, no domain to verify.
# For Gmail: create an App Password (Google Account → Security → 2-Step
# Verification → App passwords) and paste it below. The account password will
# NOT work. Leave BOOKING_FROM_EMAIL empty to send as SMTP_USER.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Route B — Resend (https://resend.com). Better deliverability, but needs a
# verified sending domain. Used only when the SMTP variables above are empty.
RESEND_API_KEY=
# Display name and address mail is sent from. With SMTP this must be an address
# the account is allowed to send as; with Resend it must be a verified domain.
BOOKING_FROM_EMAIL=

# Without either route, emails are logged to the console in development and the
# booking still completes; in production the action returns an error.
